generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model games {
  id             Int            @id @default(autoincrement())
  slug           String         @unique
  source_id      String?        @unique
  title          String
  description_es String?
  description_en String?
  cover_url      String?
  release_year   Int?
  updated_at     DateTime       @updatedAt
  complexity     Float?
  coziness       Float?
  darkness       Float?
  developers     String[]       @default([])
  difficulty     Float?
  exploration    Float?
  game_modes     GameMode[]     @default([UNKNOWN])
  horror         Float?
  humor          Float?
  isolation      Float?
  keywords       String[]       @default([])
  narrative      Float?
  pace           Float?
  perspectives   Perspective[]  @default([UNKNOWN])
  publishers     String[]       @default([])
  search_count   Int            @default(0)
  strategy       Float?
  tension        Float?
  violence       Float?
  genres         Genre[]        @default([UNKNOWN])
  platforms      Platform[]     @default([UNKNOWN])
  user_games     user_games[]
}

model user_games {
  user_id        Int
  game_id        Int
  status         game_status?
  recommendation recommendation?
  review         String?
  games          games           @relation(fields: [game_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, game_id])
}

model users {
  id         Int               @id @default(autoincrement())
  email      String            @unique
  created_at DateTime          @default(now())
  role       Role              @default(USER)
  session    sessions?
  user_games user_games[]
  identities user_identities[]
}

model permissions {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  role_permissions role_permissions[]
}

model role_permissions {
  role          Role
  permission_id Int
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role, permission_id])
}

model user_identities {
  id           Int      @id @default(autoincrement())
  user_id      Int
  provider     String
  provider_sub String
  created_at   DateTime @default(now())
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_sub])
}

model sessions {
  id             Int              @id @default(autoincrement())
  user_id        Int              @unique
  created_at     DateTime         @default(now())
  expires_at     DateTime
  revoked_at     DateTime?
  refresh_tokens refresh_tokens[]
  users          users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model refresh_tokens {
  id         Int       @id @default(autoincrement())
  session_id Int
  token_hash String    @unique
  created_at DateTime  @default(now())
  revoked_at DateTime?
  sessions   sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

/*
 * Léxico de keywords canónicas: vocabulario controlado del catálogo.
 * Un término nuevo se ASIMILA a un canónico (alias) o entra como entrada
 * nueva si es suficientemente distinto (similitud de embeddings < umbral).
 * El matcher sigue comparando talos literales: el léxico normaliza el DATO,
 * nunca el matching. Ver .opencode/plans/roadmap-lexico-embeddings.md.
 */
model keyword_lexicon {
  id         Int      @id @default(autoincrement())
  canonical  String   @unique
  aliases    String[] @default([])
  embedding  Json
  source     String   @default("mined")
  frequency  Int      @default(0)
  created_at DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

enum game_status {
  PENDING
  PLAYED
  COMPLETED
}

enum recommendation {
  HIGHLY_RECOMMENDED
  RECOMMENDED
  MEH
  NOT_RECOMMENDED
}

enum Genre {
  ACTION
  ADVENTURE
  ARCADE
  CASUAL
  FIGHTING
  HORROR
  INDIE
  MMO
  PLATFORMER
  PUZZLE
  RACING
  RPG
  SHOOTER
  SIMULATION
  SPORTS
  STRATEGY
  VISUAL_NOVEL
  UNKNOWN
}

enum Platform {
  PC
  MAC
  LINUX
  PS5
  PS4
  PS3
  PS2
  PS1
  PS_VITA
  PSP
  XBOX_SERIES
  XBOX_ONE
  XBOX_360
  XBOX
  SWITCH
  WII_U
  WII
  GAMECUBE
  N64
  SNES
  NES
  NINTENDO_3DS
  DS
  GAME_BOY
  GAME_BOY_ADVANCE
  IOS
  ANDROID
  UNKNOWN
}

enum GameMode {
  SINGLE_PLAYER
  MULTIPLAYER
  COOPERATIVE
  COMPETITIVE
  UNKNOWN
}

enum Perspective {
  FIRST_PERSON
  THIRD_PERSON
  TOP_DOWN
  ISOMETRIC
  SIDE_VIEW
  TEXT
  UNKNOWN
}
